# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of frontends allowed to call the API ("*" allows any origin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse proxies in front of the app (1 on Render/Railway/Heroku), 0 when running directly
TRUST_PROXY=0

# Gmail SMTP. MAIL_PASS must be a Gmail App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
# Note: hosts that block outbound SMTP ports (e.g. Render's free plan) can't send these emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Optional: defaults to true for port 465, false otherwise (STARTTLS on 587)
# MAIL_SECURE=true
MAIL_USER=you@gmail.com
MAIL_PASS=abcd efgh ijkl mnop
MAIL_FROM_NAME=Mohd Moazzam

# Where contact form messages are delivered
OWNER_EMAIL=mohdmozzam27@gmail.com

# Secret used to sign email verification codes (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=replace-with-a-long-random-string
