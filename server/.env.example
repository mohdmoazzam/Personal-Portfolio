# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of frontends allowed to call the API ("*" allows any origin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse proxies in front of the app (1 on Render/Railway/Heroku), 0 when running directly
TRUST_PROXY=0

# Brevo (https://app.brevo.com). Create a key under SMTP & API > API keys.
# The sender address must be verified under Senders, Domains & Dedicated IPs.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Mohd Moazzam
# Sender address; defaults to OWNER_EMAIL when unset
MAIL_FROM_EMAIL=

# Where contact form messages are delivered
OWNER_EMAIL=mohdmozzam27@gmail.com

# Secret used to sign email verification codes (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=replace-with-a-long-random-string
